# Optional: restrict which Minecraft hosts the proxy may connect to.
# Comma separated, exact hostnames or *.suffix wildcards.
# PROXY_ALLOWED_HOSTS=play.example.com,*.mc.example.net

# Maximum concurrent TCP tunnels per proxy instance (default 200).
# PROXY_MAX_CONNECTIONS=200

# Microsoft public client id used for the live device-code flow.
# prismarine-auth uses the Nintendo Switch title for Java Edition.
# MSA_CLIENT_ID=00000000441cc96b

# Local development only: allow the proxy to reach private / loopback IPs.
# PROXY_ALLOW_PRIVATE=1
